# Wisp keeps NO chat data on the server. Redis (Upstash) is used ONLY to reserve
# connection codes and to broker the WebRTC handshake — never messages, files,
# or identities; short TTLs wipe everything within a minute.
#
# Get these free at https://console.upstash.com → create a Redis database →
# "REST API" section → copy the URL and token below.
UPSTASH_REDIS_REST_URL="https://vital-swan-159624.upstash.io"
UPSTASH_REDIS_REST_TOKEN="gQAAAAAAAm-IAAIgcDFlODM4Y2NmMDMzNGI0NDBiOTI4NGJkOGE1ZDgyOTFhNQ"

# Public app URL (used for building shareable invite links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional TURN relay (leave empty for pure peer-to-peer with public STUN only).
# A TURN server helps the ~10-20% of connections behind strict NATs/firewalls.
# It only relays DTLS-encrypted traffic, so it can never read your data.
# NEXT_PUBLIC_TURN_URL=turn:your-turn-host:3478
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=
